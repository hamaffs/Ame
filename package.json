{
  "name": "ame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Amé — a personal AI assistant (Electron + React + Python).",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run electron:dev",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "backend": "./.venv/bin/python -u -m backend.server",
    "lint": "echo \"(no linter configured)\" && exit 0"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.453.0",
    "marked": "^14.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "io.ame.app",
    "productName": "Ame",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/ame-orb.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/ame-orb.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/ame-orb.icns"
    },
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*.py",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      }
    ]
  }
}
