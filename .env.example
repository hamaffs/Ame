# Amé environment template.
# Copy this file to `.env` at the repo root (dev) or to the per-user
# app-data path (packaged builds; see backend/__init__.py get_env_path):
#   Linux:   $XDG_CONFIG_HOME/ame/.env  (default: ~/.config/ame/.env)
#   macOS:   ~/Library/Application Support/ame/.env
#   Windows: %APPDATA%\ame\.env

# ── LLM providers (at least one required) ────────────────────────────────
# Gemini / Google AI Studio (primary — used for Gemini Live voice + tasks)
GEMINI_API_KEY=
GOOGLE_AI_STUDIO_KEY=
GOOGLE_API_KEY=

# Optional fallbacks
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Voice ───────────────────────────────────────────────────────────────
# Gemini Live voice (Zephyr, Puck, Charon, Kore, Fenrir, etc.)
GEMINI_VOICE=Zephyr

# ── Local LLM (optional — Ollama) ───────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# ── Spotify (optional — music agent) ────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ── Frontend ────────────────────────────────────────────────────────────
# Override the backend URL for the React app (defaults to localhost:8766)
VITE_BACKEND_URL=http://localhost:8766
